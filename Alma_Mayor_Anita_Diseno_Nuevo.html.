<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#765c91"><title>Alma Mayor · Anita</title><style>*{box-sizing:border-box}body{margin:0;font:20px system-ui,Arial;background:#f9f3f9;color:#30243b}header{background:#765c91;color:white;padding:24px;text-align:center}h1{margin:0;font-size:32px}main{max-width:680px;margin:auto;padding:18px}.card{background:white;border-radius:20px;padding:20px;margin:16px 0;box-shadow:0 3px 12px #35204215}h2{margin:0 0 12px;font-size:25px}button,a.call{border:0;border-radius:15px;background:#765c91;color:white;padding:16px;font-size:21px;min-height:58px;margin:5px 3px;cursor:pointer;display:inline-block;text-decoration:none}button:focus-visible,input:focus-visible{outline:4px solid #ffbc5c}button.secondary{background:#e9ddec;color:#30243b}input{width:100%;font:21px system-ui;padding:13px;border:2px solid #a88cb5;border-radius:12px;margin:8px 0}.answer{background:#f5edf9;padding:16px;border-radius:12px;min-height:70px;line-height:1.5}.small{font-size:16px;color:#554b5b}#status{font-size:17px}footer{text-align:center;padding:25px;font-size:15px}</style></head><body><header><h1>🌷 Alma Mayor</h1><p>¡Hola, Anita! Qué alegría verte hoy.</p></header><main><section class="card"><h2>💬 Mi compañera</h2><p>Pulsa «Hablar» y cuéntame cómo estás.</p><button id="talk">🎤 Hablar</button><button class="secondary" id="stop">🔇 Detener voz</button><p id="status" role="status">Lista para conversar.</p><div class="answer" id="reply" aria-live="polite">¡Buenos días, Anita! ¿Te gustaría conversar o jugar un rato?</div><p class="small">Esta primera versión responde con frases preparadas; todavía no es una conversación con inteligencia artificial.</p></section><section class="card"><h2>🧠 Ejercita tu memoria</h2><p id="question">Pulsa para comenzar.</p><div id="choices"></div><div id="feedback" role="status"></div><button id="game">🎲 Otra pregunta</button></section><section class="card"><h2>❤️ ¿Cómo te sientes?</h2><button onclick="mood('alegre')">😊 Bien</button><button onclick="mood('tranquila')">🌼 Tranquila</button><button onclick="mood('triste')">💙 Triste</button><p id="moodResult" aria-live="polite"></p></section><section class="card"><h2>💧 Mis recordatorios</h2><p>Guarda una actividad. Se mostrará aquí cuando vuelvas a abrir la aplicación.</p><input id="reminder" placeholder="Ej.: Beber agua a las 15:00" aria-label="Recordatorio"><button id="save">Guardar recordatorio</button><ul id="reminders"></ul><p class="small">Estos recordatorios no generan alarmas automáticas ni avisos cuando la aplicación está cerrada. Para medicamentos, mantén también una alarma del teléfono.</p></section><section class="card"><h2>📞 Mi familia</h2><label for="phone">Número de contacto familiar</label><input id="phone" type="tel" placeholder="Ej.: +56912345678"><button id="savePhone">Guardar teléfono</button><p><a id="call" class="call" href="#" aria-label="Llamar a mi familia">📞 Llamar a mi familia</a></p><p class="small">La llamada requiere confirmación en el teléfono. En emergencias, utiliza los servicios de emergencia.</p></section></main><footer>Hecho con cariño para Anita 🌷 · Los datos se guardan solo en este navegador.</footer><script>
const $=id=>document.getElementById(id);let speech;
function say(t){if(!('speechSynthesis'in window))return; speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.lang='es-CL';u.rate=.85;speechSynthesis.speak(u)}
function respond(t){$('reply').textContent=t;say(t)}
$('stop').onclick=()=>{if('speechSynthesis'in window)speechSynthesis.cancel();if(speech)speech.stop()};
$('talk').onclick=()=>{const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){$('status').textContent='Este navegador no admite reconocimiento de voz. Prueba con Chrome en Android.';return}speech=new SR();speech.lang='es-CL';speech.interimResults=false;speech.onstart=()=>$('status').textContent='Te escucho, Anita...';speech.onerror=()=>$('status').textContent='No pude escucharte. Revisa el permiso del micrófono e inténtalo otra vez.';speech.onresult=e=>{const s=e.results[0][0].transcript.toLowerCase();$('status').textContent='Dijiste: '+s;let r='Qué gusto escucharte, Anita. ¿Me cuentas algo bonito de tu día?';if(/triste|sola|soledad/.test(s))r='Te escucho, Anita. ¿Te gustaría llamar a alguien de tu familia o contarme qué te preocupa?';else if(/bien|feliz|contenta/.test(s))r='¡Qué alegría, Anita! ¿Qué ha sido lo mejor de tu día?';else if(/memoria|jugar|juego/.test(s))r='¡Vamos a jugar! Pulsa el botón de otra pregunta.';else if(/hola|buenos/.test(s))r='¡Hola, Anita! ¿Cómo estás hoy?';respond(r)};speech.start()};
const qs=[['Completa el refrán: Más vale pájaro en mano...',['que ciento volando','que cien caminando','que un gato jugando'],0],['¿Qué día viene después del martes?',['lunes','miércoles','domingo'],1],['¿Cuál de estas frutas es amarilla?',['uva morada','plátano','cereza'],1],['Completa: Al mal tiempo...',['buena cara','mucho frío','poco sol'],0],['¿Cuántos meses tiene un año?',['diez','doce','quince'],1],['¿Qué usamos para ver la hora?',['reloj','tenedor','zapato'],0]];let n=-1;
function game(){n=(n+1)%qs.length;let q=qs[n];$('question').textContent=q[0];$('choices').replaceChildren();$('feedback').textContent='';q[1].forEach((a,i)=>{const b=document.createElement('button');b.className='secondary';b.textContent=a;b.onclick=()=>{let good=i===q[2];$('feedback').textContent=good?'¡Muy bien, Anita! 🌟':'No pasa nada. La respuesta es: '+q[1][q[2]];say($('feedback').textContent)};$('choices').append(b)})}$('game').onclick=game;game();
window.mood=x=>{let t=x==='triste'?'Gracias por contármelo, Anita. Quizás te haga bien hablar con alguien de confianza.':`Gracias, Anita. Me alegra saber que te sientes ${x}.`;localStorage.setItem('almaMood',x);$('moodResult').textContent=t;say(t)};
function showReminders(){const a=JSON.parse(localStorage.getItem('almaReminders')||'[]');$('reminders').replaceChildren();a.forEach((v,i)=>{const li=document.createElement('li');li.textContent=v+' ';const b=document.createElement('button');b.className='secondary';b.textContent='Eliminar';b.onclick=()=>{a.splice(i,1);localStorage.setItem('almaReminders',JSON.stringify(a));showReminders()};li.append(b);$('reminders').append(li)})}
$('save').onclick=()=>{const v=$('reminder').value.trim();if(!v)return;const a=JSON.parse(localStorage.getItem('almaReminders')||'[]');a.push(v);localStorage.setItem('almaReminders',JSON.stringify(a));$('reminder').value='';showReminders()};showReminders();
function showPhone(){const p=localStorage.getItem('almaPhone')||'';$('phone').value=p;$('call').href=/^\+?[0-9\s-]{7,20}$/.test(p)?'tel:'+p.replace(/[\s-]/g):'#'}$('savePhone').onclick=()=>{const p=$('phone').value.trim();if(!/^\+?[0-9\s-]{7,20}$/.test(p)){alert('Escribe un teléfono válido, con código de país.');return}localStorage.setItem('almaPhone',p);showPhone();alert('Teléfono guardado')};$('call').onclick=e=>{if($('call').getAttribute('href')==='#'){e.preventDefault();alert('Primero guarda un teléfono familiar.')}};showPhone();
</script></body></html>
